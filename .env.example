# ledgerline — every setting the code reads. NO real values here.
# Locally: run `npm run setup` to create your own `.env` with generated secrets.
# On Railway: set these per service (see README "Deploy to Railway" for which service needs which).
# Never commit a real .env. Never reuse anyone else's keys.

# ---------------------------------------------------------------- database
# Connection URL for the service's own database role (ll_app, ll_sync, ll_backup, ll_verify...).
# Migrate uses an admin (superuser) URL instead.
DATABASE_URL=
# Optional for migrate: admin URL that takes precedence over DATABASE_URL.
MIGRATE_DATABASE_URL=
# Backup only: admin URL used for the full pg_dump (dumps everything incl. role list).
PG_SUPER_DATABASE_URL=
# Set to 1 ONLY to let a runtime service connect as the "postgres" superuser (not recommended).
ALLOW_SUPERUSER=
# Client-side query timeout in ms (default 30000). Set ~900000 on sync: first syncs are long.
PG_QUERY_TIMEOUT_MS=
# Local helper only (scripts/local.js): admin URL of your local database; role URLs are built from it.
LOCAL_PG_ADMIN_URL=

# ------------------------------------------------- database role passwords (migrate service only)
# The migrator gives each runtime role LOGIN with this password. Generate long random values.
ROLE_PASSWORD_LL_SYNC=
ROLE_PASSWORD_LL_APP=
ROLE_PASSWORD_LL_VERIFY=
ROLE_PASSWORD_LL_BACKUP=
# The read-only role Financial Books uses (LEDGERLINE_URL on the Financial Books side).
ROLE_PASSWORD_LL_READER=
ROLE_PASSWORD_LL_REBUILD=

# ---------------------------------------------------------------- encryption + web login
# Passphrase that encrypts Plaid access tokens inside Postgres (32 random bytes, base64).
# If you lose it, every bank must be reconnected. Same value on app and sync.
TOKEN_KEK=
# bcrypt hash of the web page password (scripts/hash-password.js or npm run setup).
APP_LOGIN_PASSWORD_HASH=
# Base32 two-factor (TOTP) secret for the web page (scripts/gen-totp.js or npm run setup).
APP_TOTP_SECRET=
# Random secret that signs login sessions (32 random bytes, base64; different from TOKEN_KEK).
APP_SESSION_SECRET=
# Port the web app listens on (Railway sets this automatically).
PORT=3000

# ---------------------------------------------------------------- Plaid (from YOUR Plaid dashboard)
# Developers → Keys → client_id.
PLAID_CLIENT_ID=
# Developers → Keys → the secret for the environment below (sandbox and production secrets differ).
PLAID_SECRET=
# sandbox (fake banks, start here) | development | production.
PLAID_ENV=sandbox
# Comma-separated Plaid products requested when connecting a bank.
PLAID_PRODUCTS=transactions
# Full URL of the app's /link/oauth page; must be listed in Plaid → Developers → API → Allowed redirect URIs.
LINK_REDIRECT_URI=http://localhost:3000/link/oauth
# Tests only: points Plaid calls at a local fake server. Leave empty in real use.
PLAID_BASE_URL=

# ---------------------------------------------------------------- organization
# Slug of your organization row (seeded as "main" by migrations/030_seed_org.sql).
LL_ORG_SLUG=main
# Sync: total minutes one sync run may take (default 20).
SYNC_DEADLINE_MIN=

# ---------------------------------------------------------------- backups (S3-compatible, e.g. Cloudflare R2)
# Bucket name in your own storage account.
BACKUP_S3_BUCKET=
# Folder prefix inside the bucket, e.g. ledgerline/
BACKUP_PREFIX=
# S3 API endpoint of your storage account.
BACKUP_S3_ENDPOINT=
# Access key limited to that bucket.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Public age recipient (starts with "age1"); the matching private key stays OFF Railway.
BACKUP_AGE_RECIPIENT=
# Set to 1 to report which old backups retention would delete without deleting them.
BACKUP_RETENTION_DRY_RUN=

# ---------------------------------------------------------------- alerts (all optional)
# Twilio SMS for urgent alerts (stale bank data, bank login needed, failed backups).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_ALERT_TO=
# Dead-man's-switch ping URLs (any heartbeat service, e.g. a healthchecks-style "ping URL").
# Each is pinged only on success; your monitor alerts you when pings stop.
HEALTHCHECKS_PING_SYNC=
HEALTHCHECKS_PING_COVERAGE=
HEALTHCHECKS_PING_ALERTS=
HEALTHCHECKS_PING_BACKUP=

# ---------------------------------------------------------------- reconciliation importer (optional)
# Path to the pdftotext program (default: pdftotext on PATH).
PDFTOTEXT_BIN=
# Read already-extracted report text from this file instead of running pdftotext.
LL_QBO_TEXT_FILE=

# ---------------------------------------------------------------- diagnostics (optional)
# services/sync/diag.js: list transactions for one account last-4, between two dates (YYYY-MM-DD).
DIAG_MASK=
DIAG_FROM=
DIAG_TO=

# ---------------------------------------------------------------- tests only
# Superuser URL of a THROWAWAY Postgres cluster used by npm test (default postgres://postgres@127.0.0.1:5499/postgres).
TEST_DATABASE_URL=
# 1 = also run the slow scale test.
LL_SCALE_TEST=
# Folder of your own real reconciliation PDFs for an optional test (leave empty).
LL_EVIDENCE_DIR=
